{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resume Data Schema",
  "description": "Schema for resume builder data structure",
  "type": "object",
  "required": ["personalInfo", "experience", "education", "skills"],
  "properties": {
    "personalInfo": {
      "type": "object",
      "required": ["name", "title", "email"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name"
        },
        "title": {
          "type": "string",
          "description": "Professional title or job position"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string"
        },
        "location": {
          "type": "string",
          "description": "City, State or City, Country"
        },
        "linkedin": {
          "type": "string",
          "description": "LinkedIn profile URL (without https://)"
        },
        "github": {
          "type": "string",
          "description": "GitHub profile URL (without https://)"
        },
        "website": {
          "type": "string",
          "description": "Personal website URL (without https://)"
        },
        "summary": {
          "type": "string",
          "description": "Professional summary or objective"
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["position", "company", "startDate", "endDate", "responsibilities"],
        "properties": {
          "position": {
            "type": "string",
            "description": "Job title"
          },
          "company": {
            "type": "string",
            "description": "Company name"
          },
          "location": {
            "type": "string",
            "description": "Job location"
          },
          "startDate": {
            "type": "string",
            "description": "Start date (e.g., 'Jan 2020')"
          },
          "endDate": {
            "type": "string",
            "description": "End date (e.g., 'Dec 2022' or 'Present')"
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of responsibilities and achievements"
          }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["degree", "institution", "graduationDate"],
        "properties": {
          "degree": {
            "type": "string",
            "description": "Degree name"
          },
          "institution": {
            "type": "string",
            "description": "School or university name"
          },
          "location": {
            "type": "string",
            "description": "Institution location"
          },
          "graduationDate": {
            "type": "string",
            "description": "Graduation date (e.g., 'May 2015')"
          },
          "gpa": {
            "type": "string",
            "description": "GPA (e.g., '3.8/4.0')"
          },
          "honors": {
            "type": "string",
            "description": "Honors or distinctions received"
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "description": "Skills organized by category",
      "patternProperties": {
        ".*": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Project name"
          },
          "description": {
            "type": "string",
            "description": "Project description"
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Technologies used"
          },
          "link": {
            "type": "string",
            "description": "Project URL or repository"
          }
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "issuer", "date"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Certification name"
          },
          "issuer": {
            "type": "string",
            "description": "Issuing organization"
          },
          "date": {
            "type": "string",
            "description": "Year obtained"
          }
        }
      }
    }
  }
}
